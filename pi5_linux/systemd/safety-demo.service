[Unit]
Description=Safety-Supervised Edge AI — Pi5 ROS2 Stack
Documentation=https://github.com/tipou82/safety-supervised-edge-ai-demo
# network.target (not network-online.target) — starts ~5 s after boot instead of ~30 s.
# UDP watchdog will retry via failure counter until Pi400 is reachable;
# static IP on eth0 (192.168.50.10) is configured shortly after network.target.
After=network.target
Wants=network.target

[Service]
Type=simple
User=yunpeng
WorkingDirectory=/home/yunpeng/safety-supervised-edge-ai-demo
# Source ROS2 and workspace, then launch
ExecStart=/bin/bash -c '\
  source /home/yunpeng/ros2_humble/install/setup.bash && \
  source /home/yunpeng/safety-supervised-edge-ai-demo/pi5_linux/ros2_ws/install/setup.bash && \
  ros2 launch safety_demo demo.launch.py'
Restart=on-failure
RestartSec=5s
# Give ROS2 enough time to shut down cleanly on stop
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
